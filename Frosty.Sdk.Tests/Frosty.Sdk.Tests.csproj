<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
    <PackageReference Include="NUnit"/>
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Frosty.Sdk\Frosty.Sdk.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TestData\original_huffman" LogicalName="Frosty.Sdk.Tests.TestData.original_huffman"/>
    <EmbeddedResource Include="TestData\new_huffman" LogicalName="Frosty.Sdk.Tests.TestData.new_huffman"/>
  </ItemGroup>

</Project>
