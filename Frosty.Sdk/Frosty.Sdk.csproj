<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Frosty SDK</Title>
    <Description>A library to access data from Frostbite game.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>TRACE;FROSTY_DEVELOPER;EBX_TYPE_SDK_DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Octokit"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="ThirdParty\*"/>
    <Content Include="ThirdParty\*" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TypeSdk\Meta\**\*.cs"/>
    <Content Include="TypeSdk\Meta\**\*.cs" LinkBase="Meta\"
             CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
